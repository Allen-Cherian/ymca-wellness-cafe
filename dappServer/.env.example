# Smart Contract Hashes
ADD_ACTIVITY_CONTRACT=your_activity_contract_hash_here
ADD_ADMIN_CONTRACT=your_admin_contract_hash_here
TRANSFER_CONTRACT=your_transfer_contract_hash_here

# File Paths
ACTIVITY_UPDATE_PATH=/path/to/activity/updates.json
ADD_ADMIN_PATH=/path/to/admin/updates.json

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=dapp_server
DB_SSL_MODE=disable

# Production Configuration Notes:
# - For production, set DB_SSL_MODE=require or DB_SSL_MODE=verify-full
# - Use a strong password for DB_PASSWORD
# - Consider using connection pooling parameters
# - Ensure PostgreSQL server is properly configured for remote connections if needed
